# Environment
ENVIRONMENT=development  # development | production

# Public Data Portal API Keys
# 여러 키 (콤마 구분) - 429 발생 시 자동 로테이션
API_KEYS=key1,key2,key3

# Cloudflare D1 Settings (Raw XML storage)
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token
CLOUDFLARE_D1_DB_ID=your_db_id

# PostgreSQL Settings (Keyword search)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=welfare_db
POSTGRES_USER=welfare_user
POSTGRES_PASSWORD=your_secure_password_here

# Qdrant Settings (Vector search)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_CACHE_COLLECTION=llm_cache
QDRANT_CACHE_THRESHOLD=0.95

# OpenAI Settings
OPENAI_API_KEY=your_openai_api_key_here

# BGE-M3 Embedding Settings
# Model will be auto-downloaded to ~/.cache/huggingface/hub/ on first run
# Set to false to disable embedding (use placeholder vectors for testing)
USE_EMBEDDINGS=true
